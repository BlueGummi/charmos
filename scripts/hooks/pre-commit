#!/bin/bash
#
# 1. clang-format (C/C++ files)
# 2. ruff format & check
# 3. tag review
# 4. incremental build check (GCC / Clang)

REPO_ROOT=$(git rev-parse --show-toplevel)
GIT_DIR=$(git rev-parse --git-dir)

have_tty() {
    [ -t 0 ] || [ -r /dev/tty ]
}

ask() {
    REPLY=""
    if [ -r /dev/tty ] && read -r REPLY </dev/tty 2>/dev/null; then
        return 0
    fi
    read -r REPLY 2>/dev/null || REPLY=""
}

sequencing() {
    [ -d "$GIT_DIR/rebase-merge" ] || [ -d "$GIT_DIR/rebase-apply" ] ||
        [ -f "$GIT_DIR/MERGE_HEAD" ] || [ -f "$GIT_DIR/CHERRY_PICK_HEAD" ] ||
        [ -f "$GIT_DIR/BISECT_LOG" ]
}

check_file() {
    local FILE="$1"
    if [ -f "$FILE" ]; then
        if ! clang-format --style=file "$FILE" | diff -q "$FILE" - >/dev/null 2>&1; then
            printf '%s\n' "$FILE"
        fi
    fi
}
export -f check_file

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(c|cc|cpp|cxx|h|hh|hpp|hxx)$')

if [ -n "$STAGED_FILES" ]; then
    JOBS=$(sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null || echo 4)
    UNFORMATTED=$(printf '%s\n' "$STAGED_FILES" | xargs -P "$JOBS" -I {} bash -c 'check_file "$@"' _ {})

    if [ -n "$UNFORMATTED" ]; then
        echo -e "\033[31mOops, these files are not formatted properly:\033[0m"
        printf ' - %s\n' "$UNFORMATTED"

        have_tty || exit 1

        printf "\033[33mFormat them? [Y/n] \033[0m"
        ask
        case "$REPLY" in
        "" | y | Y | yes | Yes | YES)
            printf '%s\n' "$UNFORMATTED" | xargs -P "$JOBS" -I {} clang-format --style=file -i {}
            printf '%s\n' "$UNFORMATTED" | xargs git add
            echo -e "\033[32mAll formatted and re-staged.\033[0m"
            ;;
        *)
            exit 1
            ;;
        esac
    fi
fi

STAGED_PY_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.py$')

if [ -n "$STAGED_PY_FILES" ] && command -v ruff >/dev/null 2>&1; then
    PY_UNFORMATTED=$(ruff format --check $STAGED_PY_FILES 2>&1 | grep "Would reformat:" | sed 's/Would reformat: //')

    if [ -n "$PY_UNFORMATTED" ]; then
        echo -e "\033[31mOops, these Python files are not formatted properly:\033[0m"
        printf ' - %s\n' "$PY_UNFORMATTED"

        have_tty || exit 1

        printf "\033[33mFormat them with ruff? [Y/n] \033[0m"
        ask
        case "$REPLY" in
        "" | y | Y | yes | Yes | YES)
            ruff format $PY_UNFORMATTED
            printf '%s\n' "$PY_UNFORMATTED" | xargs git add
            echo -e "\033[32mAll Python files formatted and re-staged.\033[0m"
            ;;
        *)
            exit 1
            ;;
        esac
    fi

    if ! ruff check $STAGED_PY_FILES >/dev/null 2>&1; then
        echo -e "\033[31mOops, Python lint issues found by ruff:\033[0m"
        ruff check $STAGED_PY_FILES

        have_tty || exit 1

        printf "\033[33mAttempt auto-fix with ruff? [Y/n] \033[0m"
        ask
        case "$REPLY" in
        "" | y | Y | yes | Yes | YES)
            ruff check --fix $STAGED_PY_FILES
            printf '%s\n' "$STAGED_PY_FILES" | xargs git add
            if ! ruff check $STAGED_PY_FILES; then
                echo -e "\033[31mRemaining lint errors must be resolved before committing.\033[0m"
                exit 1
            fi
            echo -e "\033[32mPython lint fixed and re-staged.\033[0m"
            ;;
        *)
            exit 1
            ;;
        esac
    fi
fi

sequencing && exit 0
have_tty || exit 0

# Tag review
if [ -f "$REPO_ROOT/scripts/tagscan.py" ]; then
    python3 "$REPO_ROOT/scripts/tagscan.py" --staged
    if [ $? -eq 10 ]; then
        printf "\033[33mStaged tags detected. Continue commit? [Y/n] \033[0m"
        ask
        case "$REPLY" in
        "" | y | Y | yes | Yes | YES) ;;
        *)
            echo -e "\033[31mCommit aborted. Nothing was unstaged.\033[0m"
            exit 1
            ;;
        esac
    fi
fi

# Build check
BUILD_FLAGS=(-DDEBUG_ALL=ON -DTEST_ALL=ON -DPROFILING_ALL=ON -DTEST_NIGHTMARE_ALL=ON -DINJECT_ALL=ON)

run_build() {
    local comp="$1"
    local dir="build-precommit-$comp"
    local flags=("${BUILD_FLAGS[@]}")
    [ "$comp" = clang ] && flags+=(-DCHARMOS_CLANG_TIDY=ON)
    echo -e "\033[34m[pre-commit] Checking $comp build (incremental: $dir)...\033[0m"
    if ! "$REPO_ROOT/scripts/build.sh" -B "$dir" -k "$comp" -- "${flags[@]}"; then
        echo -e "\033[31m$comp build failed. Commit aborted\033[0m"
        return 1
    fi
    return 0
}

if [ -n "$STAGED_FILES" ]; then
    printf "\033[33mCheck that it builds? [Y/n/a] (or 'g'/'c' for single compiler) \033[0m"
    ask
    case "$REPLY" in
    "" | y | Y | yes | Yes | YES | b | B)
        run_build gcc || exit 1
        run_build clang || exit 1
        echo -e "\033[32m[pre-commit] GCC and Clang (+ clang-tidy) builds passed\033[0m"
        ;;
    g | G | gcc | GCC)
        run_build gcc || exit 1
        echo -e "\033[32m[pre-commit] GCC build passed\033[0m"
        ;;
    c | C | clang | Clang | CLANG)
        run_build clang || exit 1
        echo -e "\033[32m[pre-commit] Clang build passed\033[0m"
        ;;
    a | A | abort | Abort)
        echo -e "\033[31mCommit aborted\033[0m"
        exit 1
        ;;
    *)
        echo -e "\033[33mSkipped build check\033[0m"
        ;;
    esac
fi

exit 0

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://charmos.dev/schemas/nightmare/fleet-snapshot-v1.schema.json",
  "title": "CharmOS Nightmare fleet snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "version", "evaluatedAt", "window", "repository",
    "runners", "batches", "partial"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "version": { "$ref": "#/$defs/id" },
    "evaluatedAt": { "$ref": "#/$defs/instant" },
    "window": { "$ref": "#/$defs/window" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "name", "ref", "refs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "owner": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ref": { "type": "string", "minLength": 1, "maxLength": 255 },
        "refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 255 }
        }
      }
    },
    "runners": {
      "type": "array",
      "items": { "$ref": "#/$defs/runner" }
    },
    "batches": {
      "type": "array",
      "items": { "$ref": "#/$defs/batch" }
    },
    "partial": { "type": "boolean" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_:-]{0,127}$" },
    "instant": { "type": "string", "format": "date-time" },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startsAt", "endsAt"],
      "properties": {
        "startsAt": { "$ref": "#/$defs/instant" },
        "endsAt": { "$ref": "#/$defs/instant" }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "number", "state", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "number": { "type": "integer", "minimum": 1 },
        "state": { "enum": ["idle", "running", "warning", "failed"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "trace_sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "iterations"],
      "properties": {
        "at": { "$ref": "#/$defs/instant" },
        "iterations": { "type": "integer", "minimum": 0 }
      }
    },
    "slice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "taskId", "runnerId", "startsAt", "endsAt",
        "nominalEndsAt", "immutable", "trace"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "taskId": { "$ref": "#/$defs/id" },
        "runnerId": { "$ref": "#/$defs/id" },
        "startsAt": { "$ref": "#/$defs/instant" },
        "endsAt": { "$ref": "#/$defs/instant" },
        "nominalEndsAt": { "$ref": "#/$defs/instant" },
        "immutable": { "type": "boolean" },
        "trace": {
          "type": "array",
          "items": { "$ref": "#/$defs/trace_sample" }
        }
      }
    },
    "buffer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startsAt", "endsAt", "ratio", "immutable"],
      "properties": {
        "startsAt": { "$ref": "#/$defs/instant" },
        "endsAt": { "$ref": "#/$defs/instant" },
        "ratio": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
        "immutable": { "const": true }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "family", "instance", "runnerId", "state",
        "health", "color", "started", "cancelled", "slice", "elasticBuffer"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "family": { "type": "string", "minLength": 1, "maxLength": 128 },
        "instance": { "type": ["integer", "null"], "minimum": 1 },
        "runnerId": { "$ref": "#/$defs/id" },
        "state": { "enum": ["idle", "running", "passed", "warning", "crashed"] },
        "health": { "enum": ["healthy", "warning", "failed"] },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "started": { "type": "boolean" },
        "cancelled": { "type": "boolean" },
        "slice": { "$ref": "#/$defs/slice" },
        "elasticBuffer": { "$ref": "#/$defs/buffer" }
      }
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runnerIds", "startsAt", "endsAt", "policyReserveMinutes"],
      "properties": {
        "runnerIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "startsAt": { "$ref": "#/$defs/instant" },
        "endsAt": { "$ref": "#/$defs/instant" },
        "policyReserveMinutes": { "type": "number", "minimum": 0 }
      }
    },
    "residualTail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startsAt", "endsAt", "mutableTaskIds"],
      "properties": {
        "startsAt": { "$ref": "#/$defs/instant" },
        "endsAt": { "$ref": "#/$defs/instant" },
        "mutableTaskIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "version", "name", "color", "lifecycle", "health",
        "ownership", "template", "definitionToml", "lease", "tasks",
        "startedPrefixTaskIds", "residualTail", "updatedAt"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "lifecycle": { "enum": ["draft", "queued", "running", "passed", "failed", "completed"] },
        "health": { "enum": ["healthy", "warning", "failed"] },
        "ownership": { "enum": ["ad-hoc", "repository"] },
        "template": { "type": "string", "maxLength": 128 },
        "definitionToml": { "type": "string", "minLength": 1, "maxLength": 65535 },
        "lease": { "$ref": "#/$defs/lease" },
        "tasks": { "type": "array", "items": { "$ref": "#/$defs/task" } },
        "startedPrefixTaskIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "residualTail": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/residualTail" }]
        },
        "updatedAt": { "$ref": "#/$defs/instant" }
      }
    }
  }
}
